# pkg-config file generated by gen-pkgconfig
# vile:makemode

prefix=/workspace/.pg
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include/ncursesw
abi_version=6
major_version=6
version=6.6.20251230

Name: ncursesw
Description: ncurses 6.6 library
Version: ${version}
URL: https://invisible-island.net/ncurses
Requires.private: 
Libs:  -L/workspace/.pg/lib -Wl,-O2 -Wl,--sort-common -Wl,--allow-shlib-undefined -Wl,-rpath,/workspace/.pg/lib -Wl,-rpath-link,/workspace/.pg/lib -lncursesw -ltinfow
Libs.private:  
Cflags:  -D_GNU_SOURCE -DNCURSES_WIDECHAR -I${includedir} -I/workspace/.pg/include
